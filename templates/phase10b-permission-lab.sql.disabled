-- Staged synthetic lab. ONLY the reviewed runner on a fresh disposable LOCAL PostgreSQL 17 cluster.
-- Not a migration; never run against Supabase or any existing database.
\set ON_ERROR_STOP on
-- LAB_SESSION: admin
DO $$ BEGIN
  IF current_database() <> 'synthetic_permission_lab' THEN RAISE EXCEPTION 'Wrong disposable database'; END IF;
  IF EXISTS (SELECT 1 FROM pg_roles WHERE rolname LIKE 'ncaaf_lab_%') THEN RAISE EXCEPTION 'Refuse existing roles'; END IF;
END $$;
CREATE ROLE ncaaf_lab_owner NOLOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE NOINHERIT NOBYPASSRLS;
CREATE ROLE ncaaf_lab_writer NOLOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE NOINHERIT NOBYPASSRLS;
CREATE ROLE ncaaf_lab_reader NOLOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE NOINHERIT NOBYPASSRLS;
CREATE ROLE ncaaf_lab_recovery NOLOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE NOINHERIT NOBYPASSRLS;
CREATE ROLE ncaaf_lab_cleanup NOLOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE NOINHERIT NOBYPASSRLS;
CREATE SCHEMA synthetic_mlb AUTHORIZATION ncaaf_lab_owner;
CREATE SCHEMA synthetic_ncaaf AUTHORIZATION ncaaf_lab_owner;
CREATE SCHEMA synthetic_checks;
GRANT USAGE ON SCHEMA synthetic_checks TO PUBLIC;
CREATE FUNCTION synthetic_checks.expect_state(label text, command text, wanted text) RETURNS void
LANGUAGE plpgsql SECURITY INVOKER SET search_path=pg_catalog,pg_temp AS $$
DECLARE actual text;
BEGIN
  BEGIN EXECUTE command;
  EXCEPTION WHEN OTHERS THEN GET STACKED DIAGNOSTICS actual=RETURNED_SQLSTATE;
  END;
  IF actual IS DISTINCT FROM wanted THEN RAISE EXCEPTION '% expected %, got %',label,wanted,actual; END IF;
  RAISE NOTICE 'EXPECTED_DENIAL_PASS: % [%]',label,wanted;
END $$;
SET ROLE ncaaf_lab_owner;
CREATE TABLE synthetic_mlb.canary(id integer PRIMARY KEY, value integer NOT NULL);
INSERT INTO synthetic_mlb.canary VALUES(1,0);
ALTER TABLE synthetic_mlb.canary ENABLE ROW LEVEL SECURITY;
-- Original synthetic risk pattern, not copied from any real function.
CREATE FUNCTION synthetic_mlb.bump_canary() RETURNS void LANGUAGE sql SECURITY DEFINER
SET search_path=pg_catalog,pg_temp AS $$ UPDATE synthetic_mlb.canary SET value=value+1 WHERE id=1 $$;
GRANT USAGE ON SCHEMA synthetic_mlb TO PUBLIC;
RESET ROLE;
-- LAB_SESSION: ncaaf_lab_writer
SELECT synthetic_mlb.bump_canary(); -- expected baseline PUBLIC definer access
SELECT synthetic_checks.expect_state('direct MLB rows denied','SELECT * FROM synthetic_mlb.canary','42501');
-- LAB_SESSION: admin
DO $$ BEGIN IF (SELECT value FROM synthetic_mlb.canary WHERE id=1)<>1 THEN RAISE EXCEPTION 'Risk baseline not reproduced'; END IF; END $$;
SET ROLE ncaaf_lab_owner;
REVOKE EXECUTE ON FUNCTION synthetic_mlb.bump_canary() FROM PUBLIC;
-- Harden defaults BEFORE creating pilot objects/functions; scoped to fresh synthetic schema.
ALTER DEFAULT PRIVILEGES REVOKE EXECUTE ON FUNCTIONS FROM PUBLIC;
ALTER DEFAULT PRIVILEGES IN SCHEMA synthetic_ncaaf REVOKE ALL ON TABLES FROM PUBLIC;
CREATE TABLE synthetic_ncaaf.control(id integer PRIMARY KEY CHECK(id=1),generation bigint NOT NULL,fence bigint NOT NULL,expires timestamptz NOT NULL);
INSERT INTO synthetic_ncaaf.control VALUES(1,0,0,'epoch');
CREATE TABLE synthetic_ncaaf.forecasts(id text PRIMARY KEY CHECK(id LIKE 'SYNTHETIC-%'),sport text NOT NULL CHECK(sport='NCAAF_SYNTHETIC'),score integer NOT NULL);
CREATE TABLE synthetic_ncaaf.checkpoints(generation bigint PRIMARY KEY,forecast_id text UNIQUE NOT NULL REFERENCES synthetic_ncaaf.forecasts(id),fence bigint NOT NULL);
ALTER TABLE synthetic_ncaaf.forecasts ENABLE ROW LEVEL SECURITY;
ALTER TABLE synthetic_ncaaf.forecasts FORCE ROW LEVEL SECURITY;
ALTER TABLE synthetic_ncaaf.checkpoints ENABLE ROW LEVEL SECURITY;
ALTER TABLE synthetic_ncaaf.checkpoints FORCE ROW LEVEL SECURITY;
CREATE POLICY owner_forecasts ON synthetic_ncaaf.forecasts TO ncaaf_lab_owner USING(sport='NCAAF_SYNTHETIC') WITH CHECK(sport='NCAAF_SYNTHETIC');
CREATE POLICY read_forecasts ON synthetic_ncaaf.forecasts FOR SELECT TO ncaaf_lab_reader,ncaaf_lab_recovery USING(sport='NCAAF_SYNTHETIC');
CREATE POLICY owner_checkpoints ON synthetic_ncaaf.checkpoints TO ncaaf_lab_owner USING(true) WITH CHECK(true);
CREATE POLICY read_checkpoints ON synthetic_ncaaf.checkpoints FOR SELECT TO ncaaf_lab_reader,ncaaf_lab_recovery USING(true);
CREATE FUNCTION synthetic_ncaaf.immutable_guard() RETURNS trigger LANGUAGE plpgsql SECURITY INVOKER
SET search_path=pg_catalog,pg_temp AS $$ BEGIN RAISE EXCEPTION USING ERRCODE='55000',MESSAGE='Immutable synthetic evidence'; END $$;
CREATE TRIGGER immutable_forecasts BEFORE UPDATE OR DELETE ON synthetic_ncaaf.forecasts FOR EACH ROW EXECUTE FUNCTION synthetic_ncaaf.immutable_guard();
CREATE TRIGGER immutable_checkpoints BEFORE UPDATE OR DELETE ON synthetic_ncaaf.checkpoints FOR EACH ROW EXECUTE FUNCTION synthetic_ncaaf.immutable_guard();
CREATE FUNCTION synthetic_ncaaf.claim(expected_fence bigint, seconds integer) RETURNS bigint LANGUAGE plpgsql SECURITY DEFINER
SET search_path=pg_catalog,pg_temp AS $$
DECLARE c synthetic_ncaaf.control%ROWTYPE;
BEGIN
 SELECT * INTO c FROM synthetic_ncaaf.control WHERE id=1 FOR UPDATE;
 IF seconds<1 OR seconds>1200 OR expected_fence<>c.fence OR c.expires>clock_timestamp() THEN RAISE EXCEPTION USING ERRCODE='40001',MESSAGE='Lease denied'; END IF;
 UPDATE synthetic_ncaaf.control SET fence=c.fence+1,expires=clock_timestamp()+make_interval(secs=>seconds) WHERE id=1;
 RETURN c.fence+1;
END $$;
CREATE FUNCTION synthetic_ncaaf.publish(expected_generation bigint, epoch bigint, forecast_id text, projected_score integer) RETURNS bigint LANGUAGE plpgsql SECURITY DEFINER
SET search_path=pg_catalog,pg_temp AS $$
DECLARE c synthetic_ncaaf.control%ROWTYPE;
BEGIN
 SELECT * INTO c FROM synthetic_ncaaf.control WHERE id=1 FOR UPDATE;
 IF expected_generation<>c.generation OR epoch<>c.fence OR c.expires<=clock_timestamp() THEN RAISE EXCEPTION USING ERRCODE='40001',MESSAGE='CAS/fence denied'; END IF;
 INSERT INTO synthetic_ncaaf.forecasts VALUES(forecast_id,'NCAAF_SYNTHETIC',projected_score);
 INSERT INTO synthetic_ncaaf.checkpoints VALUES(c.generation+1,forecast_id,c.fence);
 UPDATE synthetic_ncaaf.control SET generation=c.generation+1 WHERE id=1;
 RETURN c.generation+1;
END $$;
GRANT USAGE ON SCHEMA synthetic_ncaaf TO ncaaf_lab_writer,ncaaf_lab_reader,ncaaf_lab_recovery,ncaaf_lab_cleanup;
GRANT EXECUTE ON FUNCTION synthetic_ncaaf.claim(bigint,integer),synthetic_ncaaf.publish(bigint,bigint,text,integer) TO ncaaf_lab_writer;
GRANT SELECT ON synthetic_ncaaf.forecasts,synthetic_ncaaf.checkpoints TO ncaaf_lab_reader,ncaaf_lab_recovery;
-- Cleanup has no table mutation/schema DROP privilege; only bounded post-review operation.
CREATE FUNCTION synthetic_ncaaf.cleanup_receipt() RETURNS text LANGUAGE sql SECURITY INVOKER SET search_path=pg_catalog,pg_temp AS $$ SELECT 'SYNTHETIC_NO_DELETE_WITHOUT_RESTORE_REVIEW'::text $$;
GRANT EXECUTE ON FUNCTION synthetic_ncaaf.cleanup_receipt() TO ncaaf_lab_cleanup;
RESET ROLE;
-- LAB_SESSION: ncaaf_lab_writer
SELECT synthetic_ncaaf.claim(0,1200);
SELECT synthetic_ncaaf.publish(0,1,'SYNTHETIC-FIRST',21);
SELECT synthetic_checks.expect_state('stale generation','SELECT synthetic_ncaaf.publish(0,1,''SYNTHETIC-STALE'',1)','40001');
SELECT synthetic_checks.expect_state('stale fence','SELECT synthetic_ncaaf.publish(1,0,''SYNTHETIC-FENCE'',1)','40001');
SELECT synthetic_checks.expect_state('immutable ID duplicate','SELECT synthetic_ncaaf.publish(1,1,''SYNTHETIC-FIRST'',99)','23505');
SELECT synthetic_checks.expect_state('cross sport marker','SELECT synthetic_ncaaf.publish(1,1,''MLB-NOT-SYNTHETIC'',1)','23514');
SELECT synthetic_checks.expect_state('writer raw SELECT','SELECT * FROM synthetic_ncaaf.forecasts','42501');
SELECT synthetic_checks.expect_state('writer raw INSERT','INSERT INTO synthetic_ncaaf.forecasts VALUES(''SYNTHETIC-BYPASS'',''NCAAF_SYNTHETIC'',1)','42501');
SELECT synthetic_checks.expect_state('writer raw UPDATE','UPDATE synthetic_ncaaf.forecasts SET score=999','42501');
SELECT synthetic_checks.expect_state('writer raw DELETE','DELETE FROM synthetic_ncaaf.forecasts','42501');
SELECT synthetic_checks.expect_state('MLB function hardened','SELECT synthetic_mlb.bump_canary()','42501');
SELECT synthetic_checks.expect_state('schema CREATE','CREATE TABLE synthetic_ncaaf.escape(id int)','42501');
SELECT synthetic_checks.expect_state('role escalation','SET ROLE ncaaf_lab_owner','42501');
SELECT synthetic_checks.expect_state('new privileged role','CREATE ROLE synthetic_escalation SUPERUSER','42501');
-- LAB_SESSION: admin
-- LAB_SESSION: ncaaf_lab_reader
DO $$ BEGIN IF (SELECT count(*) FROM synthetic_ncaaf.forecasts)<>1 THEN RAISE EXCEPTION 'Missing immutable forecast'; END IF; END $$;
SELECT synthetic_checks.expect_state('reader writer RPC','SELECT synthetic_ncaaf.publish(1,1,''SYNTHETIC-READER'',1)','42501');
SELECT synthetic_checks.expect_state('reader claim','SELECT synthetic_ncaaf.claim(1,1)','42501');
SELECT synthetic_checks.expect_state('reader INSERT','INSERT INTO synthetic_ncaaf.forecasts VALUES(''SYNTHETIC-R'',''NCAAF_SYNTHETIC'',1)','42501');
SELECT synthetic_checks.expect_state('reader UPDATE','UPDATE synthetic_ncaaf.forecasts SET score=1','42501');
SELECT synthetic_checks.expect_state('reader DELETE','DELETE FROM synthetic_ncaaf.forecasts','42501');
SELECT synthetic_checks.expect_state('reader MLB SELECT','SELECT * FROM synthetic_mlb.canary','42501');
SELECT synthetic_checks.expect_state('reader MLB function','SELECT synthetic_mlb.bump_canary()','42501');
-- PostgreSQL catalog schema names are discoverable; do not claim names are secret.
DO $$ BEGIN IF NOT EXISTS(SELECT 1 FROM pg_namespace WHERE nspname='synthetic_mlb') THEN RAISE EXCEPTION 'Expected visible catalog name'; END IF; END $$;
-- LAB_SESSION: admin
-- LAB_SESSION: ncaaf_lab_recovery
DO $$ BEGIN IF (SELECT count(*) FROM synthetic_ncaaf.checkpoints)<>1 THEN RAISE EXCEPTION 'Recovery read failed'; END IF; END $$;
SELECT synthetic_checks.expect_state('recovery INSERT','INSERT INTO synthetic_ncaaf.forecasts VALUES(''SYNTHETIC-RECOVERY-RAW'',''NCAAF_SYNTHETIC'',1)','42501');
SELECT synthetic_checks.expect_state('recovery UPDATE','UPDATE synthetic_ncaaf.forecasts SET score=2','42501');
SELECT synthetic_checks.expect_state('recovery mutation','DELETE FROM synthetic_ncaaf.checkpoints','42501');
SELECT synthetic_checks.expect_state('recovery publication','SELECT synthetic_ncaaf.publish(1,1,''SYNTHETIC-RECOVERY'',1)','42501');
-- LAB_SESSION: admin
-- LAB_SESSION: ncaaf_lab_cleanup
SELECT synthetic_ncaaf.cleanup_receipt();
SELECT synthetic_checks.expect_state('cleanup rows denied','SELECT * FROM synthetic_ncaaf.forecasts','42501');
SELECT synthetic_checks.expect_state('unreviewed cleanup denied','DELETE FROM synthetic_ncaaf.forecasts','42501');
SELECT synthetic_checks.expect_state('cleanup publication','SELECT synthetic_ncaaf.publish(1,1,''SYNTHETIC-CLEANUP'',1)','42501');
-- LAB_SESSION: admin
-- Subtransaction-only RLS exclusion proof; rolls back policy change immediately.
-- Committed disposable policy probe visible to independently authenticated reader.
SET ROLE ncaaf_lab_owner;
ALTER POLICY read_forecasts ON synthetic_ncaaf.forecasts USING(false);
RESET ROLE;
-- LAB_SESSION: ncaaf_lab_reader
DO $$ BEGIN IF (SELECT count(*) FROM synthetic_ncaaf.forecasts)<>0 THEN RAISE EXCEPTION 'RLS exclusion failed'; END IF; END $$;
-- LAB_SESSION: admin
ALTER POLICY read_forecasts ON synthetic_ncaaf.forecasts USING(sport='NCAAF_SYNTHETIC');
-- Privileged harness checks atomic failure rollback and immutable triggers without modifying real state.
DO $$ BEGIN
 IF (SELECT generation FROM synthetic_ncaaf.control WHERE id=1)<>1 OR (SELECT count(*) FROM synthetic_ncaaf.forecasts)<>1 OR (SELECT count(*) FROM synthetic_ncaaf.checkpoints)<>1 THEN RAISE EXCEPTION 'Failed transaction leaked'; END IF;
END $$;
SELECT synthetic_checks.expect_state('forecast immutable','UPDATE synthetic_ncaaf.forecasts SET score=2','55000');
SELECT synthetic_checks.expect_state('checkpoint immutable','DELETE FROM synthetic_ncaaf.checkpoints','55000');
-- Simulate expired lease in the harness only; new epoch fences old writer.
UPDATE synthetic_ncaaf.control SET expires='epoch' WHERE id=1;
-- LAB_SESSION: ncaaf_lab_writer
SELECT synthetic_ncaaf.claim(1,1200);
SELECT synthetic_checks.expect_state('expired prior epoch','SELECT synthetic_ncaaf.publish(1,1,''SYNTHETIC-OLD'',1)','40001');
SAVEPOINT synthetic_interrupted;
SELECT synthetic_ncaaf.publish(1,2,'SYNTHETIC-INTERRUPTED',17);
ROLLBACK TO SAVEPOINT synthetic_interrupted;
SELECT synthetic_ncaaf.publish(1,2,'SYNTHETIC-RECOVERED',17);
SAVEPOINT synthetic_search_path_probe;
CREATE TEMP TABLE control(generation bigint);
INSERT INTO pg_temp.control VALUES(999);
SET LOCAL search_path=pg_temp,synthetic_mlb;
DO $$ BEGIN
 IF synthetic_ncaaf.publish(2,2,'SYNTHETIC-SHADOW-SAFE',1)<>3 OR (SELECT generation FROM pg_temp.control)<>999 THEN RAISE EXCEPTION 'Search path shadowing'; END IF;
END $$;
ROLLBACK TO SAVEPOINT synthetic_search_path_probe;
-- LAB_SESSION: admin
DO $$ BEGIN
 IF (SELECT count(*) FROM synthetic_ncaaf.forecasts)<>2 OR (SELECT generation FROM synthetic_ncaaf.control WHERE id=1)<>2 THEN RAISE EXCEPTION 'Recovery parity'; END IF;
 IF EXISTS(SELECT 1 FROM synthetic_ncaaf.forecasts WHERE id='SYNTHETIC-INTERRUPTED') THEN RAISE EXCEPTION 'Partial publication visible'; END IF;
 IF EXISTS(SELECT 1 FROM pg_proc p JOIN pg_namespace n ON n.oid=p.pronamespace CROSS JOIN LATERAL aclexplode(COALESCE(p.proacl,acldefault('f',p.proowner))) a WHERE n.nspname='synthetic_ncaaf' AND a.grantee=0 AND a.privilege_type='EXECUTE') THEN RAISE EXCEPTION 'Unexpected PUBLIC execute'; END IF;
END $$;
SELECT 'SYNTHETIC_POSTGRES_PERMISSION_LAB_PASS' AS result;
-- Staged connections need committed setup; owned cluster is destroyed by the launcher after verification.
-- LAB_COMPLETE
