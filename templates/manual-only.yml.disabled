{
  "name": "NCAAF synthetic security preflight - DISABLED TEMPLATE",
  "on": {
    "workflow_dispatch": {}
  },
  "permissions": {
    "contents": "read"
  },
  "jobs": {
    "preflight": {
      "runs-on": "windows-2022",
      "timeout-minutes": 10,
      "permissions": {
        "contents": "read"
      },
      "steps": [
        {
          "name": "Read source only",
          "uses": "actions/checkout@df4cb1c069e1874edd31b4311f1884172cec0e10",
          "with": {
            "persist-credentials": false,
            "fetch-depth": 1
          }
        },
        {
          "name": "Offline synthetic security tests",
          "shell": "pwsh",
          "run": "python -I -m unittest discover -s tests -v"
        }
      ]
    }
  }
}
